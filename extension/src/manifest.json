{
  "manifest_version": 3,
  "name": "ScrapeFlow",
  "description": "AI 웹 스크래퍼 - 데이터 추출, 내보내기, 풀 페이지 캡처",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/pattern-detector.ts", "src/content/scraper.ts", "src/content/selector.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  }
}
